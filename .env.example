# Copy this file to .env and fill in real values. .env is gitignored.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vuln_survival
DB_USER=vsp_user
DB_PASSWORD=changeme

# Separate DB used only by the test suite (tests/conftest.py creates/drops it
# on the same local Postgres instance) — never point this at production data.
TEST_DB_NAME=vuln_survival_test

# --- NVD API 2.0 ---
# Optional. Without a key: 5 requests/30s. With a free key: 50 requests/30s.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
