# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# Environment / secrets
.env

# Data (raw/processed data is regenerated by the pipeline, not committed)
data/raw/**/*.json
data/raw/**/*.csv
data/raw/**/*.csv.gz
data/raw/**/*.xml
data/raw/**/*.zip
data/processed/*
data/features/*
data/training/*
!data/raw/**/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep
!data/training/.gitkeep

# Logs
logs/**/*.log
!logs/**/.gitkeep

# Scratch
scratch/*
!scratch/.gitkeep

# Editor / OS
.DS_Store
.vscode/
.idea/

# Test / build artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
dist/
build/
