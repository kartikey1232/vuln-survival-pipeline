  "rules": [
    {
      "id": "R01",
      "text": "IF cox_risk is VeryHigh THEN priority is Critical",
      "consequent": "Critical"
    },
    {
      "id": "R02",
      "text": "IF cox_risk is High AND epss is Low THEN priority is High",
      "consequent": "High"
    },
    {
      "id": "R03",
      "text": "IF blindspot is ModelHigher AND cvss is Critical THEN priority is Critical",
      "consequent": "Critical"
    },
    {
      "id": "R04",
      "text": "IF cox_risk is High or above AND epss is High THEN priority is Critical",
      "consequent": "Critical"
    },
    {
      "id": "R05",
      "text": "IF cox_risk is Medium or above AND cvss is Critical THEN priority is High",
      "consequent": "High"
    },
    {
      "id": "R06",
      "text": "IF cox_risk is Low AND epss is Low AND cvss is not Critical THEN priority is VeryLow",
      "consequent": "VeryLow"
    },
    {
      "id": "R07",
      "text": "IF cox_risk is Low THEN priority is Low",
      "consequent": "Low"
    },
    {
      "id": "R08",
      "text": "IF cox_risk is Medium THEN priority is Medium",
      "consequent": "Medium"
    },
    {
      "id": "R09",
      "text": "IF cox_risk is Medium or above THEN priority is High",
      "consequent": "High"
    },
    {
      "id": "R10",
      "text": "IF epss is VeryHigh THEN priority is High",
      "consequent": "High"
    },
    {
      "id": "R11",
      "text": "IF cox_risk is High or above AND epss is VeryHigh THEN priority is Critical",
      "consequent": "Critical"
    },
    {
      "id": "R12",
      "text": "IF cox_risk is Medium or above AND epss is High THEN priority is High",
      "consequent": "High"
    },
    {
      "id": "R13",
      "text": "IF epss is High THEN priority is Medium",
      "consequent": "Medium"
    },
    {
      "id": "R14",
      "text": "IF cox_risk is High or above AND cvss is Critical THEN priority is Critical",
      "consequent": "Critical"
    },
    {
      "id": "R15",
      "text": "IF blindspot is Agrees AND cox_risk is Medium AND epss is Medium THEN priority is Medium",
      "consequent": "Medium"
    },
    {
      "id": "R16",
      "text": "IF cvss is Missing AND cox_risk is Low AND epss is Low THEN priority is Low",
      "consequent": "Low"
    },
    {
      "id": "R17",
      "text": "IF blindspot is EPSSHigher AND cox_risk is Low THEN priority is Low",
      "consequent": "Low"
    }
